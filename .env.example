# Current site. Set the real domain before launch.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Independent server opt-ins. Only the exact value true enables a feature.
# Credentials alone do not enable anything.
ENABLE_ADMIN=false
ENABLE_PUBLIC_GALLERY=false
ENABLE_BOOKING_API=false

# Future CMS/gallery: configure NEW resources for Sweet-lana only.
ADMIN_USERNAME=
ADMIN_PASSWORD=
MONGODB_URI=
MONGODB_DB=sweet_lana_prod
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Future Telegram booking API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional contact for retained components. Current contacts: src/lib/business.ts.
NEXT_PUBLIC_TELEGRAM=
